# Скопируйте в .env и заполните. Файл .env не публикуйте.

# Порт сервера
PORT=3000

# Публичный адрес сайта (для canonical, sitemap, Open Graph)
SITE_URL=https://marika-star.ru

# Яндекс Метрика: номер счётчика (пусто = счётчик не подключается)
METRIKA_ID=

# Получение заявок — Telegram-бот (создайте через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Получение заявок — любой webhook (MAX-бот, CRM, Make/n8n и т.п.), принимает JSON
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Ссылки на каналы связи (показываются на сайте, только если заполнены)
TELEGRAM_URL=
MAX_URL=
